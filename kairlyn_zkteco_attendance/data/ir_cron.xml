<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- 每 5 分钟检查一次；每台设备按自己的同步周期决定是否真正同步。
             点击“立即同步”时也会立即触发这个任务。 -->
        <record id="ir_cron_kairlyn_zk_sync" model="ir.cron">
            <field name="name">ZKTeco：同步考勤机</field>
            <field name="model_id" ref="model_kairlyn_zk_device"/>
            <field name="state">code</field>
            <field name="code">model._cron_sync_devices()</field>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>

        <!-- 每小时处理待重新计算的员工，并重算最近 7 天；映射变化、同步到新打卡、修改考勤规则时也会立即触发 -->
        <record id="ir_cron_kairlyn_zk_compute_days" model="ir.cron">
            <field name="name">ZKTeco：计算每日考勤</field>
            <field name="model_id" ref="model_kairlyn_zk_attendance_day"/>
            <field name="state">code</field>
            <field name="code">model._cron_compute_days()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="True"/>
        </record>

        <!-- 每天清理超过保留天数的同步日志 -->
        <record id="ir_cron_kairlyn_zk_cleanup_logs" model="ir.cron">
            <field name="name">ZKTeco：清理同步日志</field>
            <field name="model_id" ref="model_kairlyn_zk_sync_log"/>
            <field name="state">code</field>
            <field name="code">model._cron_cleanup()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
